{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Pipeline flow",
      "folder": "Fraud monitoring",
      "interval": "10s",
      "rules": [
        {
          "uid": "scoring-stopped",
          "title": "Поток скоринга остановился",
          "condition": "B",
          "for": "30s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "annotations": {
            "summary": "Поток скоринга остановился",
            "description": "Меньше 0.01 транзакции/с за 30 секунд в течение 30 секунд."
          },
          "labels": {
            "severity": "warning"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "rate(scoring_transactions_total[30s])",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 60
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.01
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "writer-stopped",
          "title": "Запись скоров остановилась",
          "condition": "B",
          "for": "30s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "annotations": {
            "summary": "Запись скоров остановилась",
            "description": "Меньше 0.01 транзакции/с за 30 секунд в течение 30 секунд."
          },
          "labels": {
            "severity": "warning"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "rate(writer_scores_total[30s])",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 60
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.01
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
